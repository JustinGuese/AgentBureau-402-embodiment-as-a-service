---
import LeadCapture from './LeadCapture.astro';
import { useTranslations, defaultLocale, type Locale } from '../i18n/t';
import { priceLabelFor } from '../lib/gateway';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const l = (path: string) => {
	if (locale === defaultLocale) return path;
	return `/${locale}${path === '/' ? '' : path}`;
};

// What the bundle actually contains, priced individually so the saving is verifiable
// rather than asserted. Every figure comes from ENDPOINTS, the same catalogue the
// gateway charges from.
const included = [
	{ label: t('pricing.table.services.ug'), price: '1,500+ USDC', note: t('pricing.table.notes.ug') },
	{ label: t('pricing.table.services.bankAccount'), price: priceLabelFor('bank_account'), note: t('pricing.table.notes.bankAccount') },
	{ label: t('pricing.table.services.vatRegister'), price: priceLabelFor('vat_registration'), note: t('pricing.table.notes.vatRegister') },
	{ label: t('pricing.table.services.vollmacht'), price: priceLabelFor('vollmacht'), note: t('pricing.table.notes.vollmacht') },
	{ label: t('pricing.table.services.annualFiling'), price: priceLabelFor('annual_filing'), note: t('pricing.table.notes.annualFiling') },
	{ label: t('pricing.table.services.vatReturn'), price: priceLabelFor('vat_return'), note: t('pricing.table.notes.vatReturn') },
];

const faqs = ['travel', 'timeline', 'whoFor', 'refund'].map((k) => ({
	q: t(`euPresence.faq.${k}.q`),
	a: t(`euPresence.faq.${k}.a`),
}));
---

<section class="bg-white py-20 sm:py-28">
	<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
		<span class="text-xs font-bold uppercase tracking-wider text-indigo-600">
			{t('euPresence.eyebrow')}
		</span>
		<h1 class="mt-4 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">
			{t('euPresence.hero.title')}
		</h1>
		<p class="mt-6 text-xl text-slate-600">
			{t('euPresence.hero.subtitle')}
		</p>
		<div class="mt-10 flex flex-col sm:flex-row justify-center gap-4">
			<a
				href="#eu-presence-lead"
				data-track="eu_presence_hero"
				class="inline-flex items-center justify-center px-8 py-3 rounded-md bg-slate-900 text-white font-semibold hover:bg-slate-800"
			>
				{t('euPresence.hero.cta')}
			</a>
			<a
				href={l('/pricing')}
				class="inline-flex items-center justify-center px-8 py-3 rounded-md border border-slate-300 text-slate-700 font-semibold hover:bg-slate-50"
			>
				{t('euPresence.hero.ctaSecondary')}
			</a>
		</div>
	</div>
</section>

<section class="py-20 bg-slate-50 border-y border-slate-200">
	<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
		<h2 class="text-3xl font-extrabold text-slate-900 text-center">{t('euPresence.included.title')}</h2>
		<p class="mt-4 text-lg text-slate-600 text-center max-w-2xl mx-auto">
			{t('euPresence.included.subtitle')}
		</p>

		<div class="mt-12 overflow-hidden rounded-xl border border-slate-200 bg-white">
			<table class="min-w-full divide-y divide-slate-200">
				<thead class="bg-slate-50">
					<tr>
						<th scope="col" class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">{t('pricing.table.service')}</th>
						<th scope="col" class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">{t('pricing.table.price')}</th>
						<th scope="col" class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">{t('pricing.table.note')}</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-slate-200">
					{included.map((row) => (
						<tr>
							<td class="px-6 py-4 text-sm font-medium text-slate-900">{row.label}</td>
							<td class="px-6 py-4 text-sm text-slate-600 whitespace-nowrap">{row.price}</td>
							<td class="px-6 py-4 text-sm text-slate-500">{row.note}</td>
						</tr>
					))}
				</tbody>
				<tfoot class="bg-indigo-50">
					<tr>
						<td class="px-6 py-4 text-sm font-bold text-slate-900">{t('euPresence.included.bundleRow')}</td>
						<td class="px-6 py-4 text-sm font-bold text-indigo-700 whitespace-nowrap">{priceLabelFor('eu_presence')}</td>
						<td class="px-6 py-4 text-sm text-indigo-800">{t('euPresence.included.bundleNote')}</td>
					</tr>
				</tfoot>
			</table>
		</div>

		<p class="mt-4 text-xs text-slate-500 text-center max-w-2xl mx-auto">
			{t('euPresence.included.disclaimer')}
		</p>
	</div>
</section>

<section class="py-20 bg-white">
	<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
		<h2 class="text-3xl font-extrabold text-slate-900 text-center mb-12">{t('euPresence.who.title')}</h2>
		<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
			{['founder', 'saas', 'agent'].map((k) => (
				<div class="rounded-xl border border-slate-200 p-8">
					<h3 class="font-bold text-slate-900">{t(`euPresence.who.${k}.title`)}</h3>
					<p class="mt-3 text-slate-600 text-sm leading-relaxed">{t(`euPresence.who.${k}.desc`)}</p>
				</div>
			))}
		</div>
	</div>
</section>

<section class="py-20 bg-slate-50 border-y border-slate-200">
	<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
		<h2 class="text-3xl font-extrabold text-slate-900 text-center mb-12">{t('euPresence.faq.title')}</h2>
		<dl class="space-y-8">
			{faqs.map((f) => (
				<div>
					<dt class="font-bold text-slate-900">{f.q}</dt>
					<dd class="mt-2 text-slate-600 leading-relaxed">{f.a}</dd>
				</div>
			))}
		</dl>
	</div>
</section>

<section id="eu-presence-lead" class="py-20 bg-white scroll-mt-8">
	<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
		<LeadCapture source="eu_presence" variant="light" />
	</div>
</section>
