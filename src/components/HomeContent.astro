---
// Single source for the homepage body. Previously index.astro (200 lines) and
// [lang]/index.astro (113 lines) were hand-duplicated and had drifted: every localized
// homepage was silently missing the security pillars, the whole MCP section and 4 of the
// 8 service cards. Both routes now render this.
import Hero from './Hero.astro';
import ServiceCard from './ServiceCard.astro';
import PaymentFlow from './PaymentFlow.astro';
import LeadCapture from './LeadCapture.astro';
import ComplianceScanner from './ComplianceScanner.tsx';
import { useTranslations, defaultLocale, type Locale } from '../i18n/t';
import { priceLabelFor } from '../lib/gateway';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const l = (path: string) => {
	if (locale === defaultLocale) return path;
	return `/${locale}${path === '/' ? '' : path}`;
};
---

<Hero title={t('hero.title')} subtitle={t('hero.subtitle')} />

<section class="py-24 bg-white">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="text-center mb-16">
			<h2 class="text-3xl font-extrabold text-slate-900">{t('compliance.title')}</h2>
			<p class="mt-4 text-lg text-slate-600">{t('compliance.subtitle')}</p>
		</div>
		<ComplianceScanner
			client:load
			title={t('compliance.title')}
			subtitle={t('compliance.subtitle')}
			stepLabel={t('compliance.stepLabel')}
			resultTitle={t('compliance.resultTitle')}
			resultSubtitle={t('compliance.resultSubtitle')}
			ctaText={t('compliance.ctaText')}
			resetText={t('compliance.resetText')}
			questions={t('compliance.questions')}
			ctaHref={l('/pricing')}
		/>
	</div>
</section>

<section class="py-24 bg-slate-50">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="text-center">
			<h2 class="text-3xl font-extrabold text-slate-900">{t('home.howItWorks.title')}</h2>
			<p class="mt-4 text-lg text-slate-600">{t('home.howItWorks.subtitle')}</p>
		</div>
		<PaymentFlow />

		<div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-8">
			<div class="flex flex-col items-center text-center">
				<div class="p-3 bg-blue-100 text-blue-600 rounded-full mb-4">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
					</svg>
				</div>
				<h3 class="font-bold text-slate-900">SIWE Binding</h3>
				<p class="mt-2 text-sm text-slate-600">{t('home.security.siwe')}</p>
			</div>
			<div class="flex flex-col items-center text-center">
				<div class="p-3 bg-green-100 text-green-600 rounded-full mb-4">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
					</svg>
				</div>
				<h3 class="font-bold text-slate-900">HITL Disclosure</h3>
				<p class="mt-2 text-sm text-slate-600">{t('home.security.hitl')}</p>
			</div>
			<div class="flex flex-col items-center text-center">
				<div class="p-3 bg-purple-100 text-purple-600 rounded-full mb-4">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
					</svg>
				</div>
				<h3 class="font-bold text-slate-900">AML Compliance</h3>
				<p class="mt-2 text-sm text-slate-600">{t('home.security.aml')}</p>
			</div>
		</div>

		<div class="mt-16 text-center">
			<a
				href={l('/pricing')}
				data-track="howitworks_pricing"
				class="inline-flex items-center px-6 py-3 rounded-md bg-slate-900 text-white font-semibold hover:bg-slate-800"
			>
				{t('home.howItWorks.cta')}
			</a>
		</div>
	</div>
</section>

<section class="py-24 bg-white border-y border-slate-100">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
			<div>
				<h2 class="text-3xl font-extrabold text-slate-900 sm:text-4xl">{t('home.mcp.title')}</h2>
				<p class="mt-4 text-xl text-slate-600 font-medium">{t('home.mcp.subtitle')}</p>
				<p class="mt-6 text-lg text-slate-600 leading-relaxed">
					{t('home.mcp.description')}
				</p>
				<div class="mt-10">
					<a href="/docs/for-agents/mcp-connection" class="inline-flex items-center text-indigo-600 font-bold hover:text-indigo-500">
						{t('home.mcp.cta')}
						<svg class="ml-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
						</svg>
					</a>
				</div>
			</div>
			<div class="bg-slate-900 rounded-2xl p-8 shadow-2xl text-slate-300 font-mono text-sm">
				<div class="flex items-center space-x-2 mb-6">
					<div class="w-3 h-3 rounded-full bg-red-500"></div>
					<div class="w-3 h-3 rounded-full bg-yellow-500"></div>
					<div class="w-3 h-3 rounded-full bg-green-500"></div>
					<span class="ml-2 text-slate-500 text-xs">claude_desktop_config.json</span>
				</div>
				<pre class="overflow-x-auto"><code>{`{
  "mcpServers": {
    "AgentBureau": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://agentbureau-api.datafortress.cloud/mcp"]
    }
  }
}`}</code></pre>
			</div>
		</div>
	</div>
</section>

<section class="py-20 bg-white">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="text-center max-w-3xl mx-auto mb-16">
			<h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
				{t('home.services.title')}
			</h2>
			<p class="mt-4 text-lg text-slate-600">
				{t('home.services.subtitle')}
			</p>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
			<ServiceCard
				title={t('services.gmbh.title').split(' - ')[0]}
				description={t('services.gmbh.description')}
				price={priceLabelFor('company_formation')}
				priceNote={t('pricing.table.notes.gmbh')}
				icon="building"
				href={l('/gmbh-gruenden')}
			/>
			<ServiceCard
				title={t('services.invoice.title').split(' - ')[0]}
				description={t('services.invoice.description')}
				price={priceLabelFor('invoice')}
				priceNote={t('pricing.table.notes.invoice')}
				icon="invoice"
				href={l('/invoice-api')}
			/>
			<ServiceCard
				title={t('services.fax.title').split(' - ')[0]}
				description={t('services.fax.description')}
				price={priceLabelFor('fax')}
				priceNote={t('pricing.table.notes.fax')}
				icon="fax"
				href={l('/fax-api')}
			/>
			<ServiceCard
				title={t('services.letter.title').split(' - ')[0]}
				description={t('services.letter.description')}
				price={priceLabelFor('letter')}
				priceNote={t('pricing.table.notes.letter')}
				icon="mail"
				href={l('/letter-api')}
			/>
			<ServiceCard
				title={t('services.banking.title')}
				description={t('services.banking.description')}
				price={priceLabelFor('bank_account')}
				priceNote={t('pricing.table.notes.bankAccount')}
				icon="credit-card"
				href="/docs/services/banking"
			/>
			<ServiceCard
				title={t('services.tax.title')}
				description={t('services.tax.description')}
				price={priceLabelFor('vat_registration')}
				priceNote={t('pricing.table.notes.vatRegister')}
				icon="document-text"
				href="/docs/services/vat-compliance"
			/>
			<ServiceCard
				title={t('services.legal.title')}
				description={t('services.legal.description')}
				price={priceLabelFor('vollmacht')}
				priceNote={t('pricing.table.notes.vollmacht')}
				icon="shield-check"
				href="/docs/services/vollmacht"
			/>
			<ServiceCard
				title={t('services.marketplace.title')}
				description={t('services.marketplace.description')}
				icon="shopping-cart"
				href={l('/marketplace')}
			/>
		</div>

		<div class="mt-12 text-center">
			<a
				href={l('/pricing')}
				data-track="services_pricing"
				class="inline-flex items-center font-bold text-indigo-600 hover:text-indigo-500"
			>
				{t('home.services.cta')}
				<svg class="ml-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
				</svg>
			</a>
		</div>
	</div>
</section>

{/*
	The bundle band. EU-Presence is the only upsell construct in the catalogue and it used
	to exist solely as one row of the pricing table — so nothing on the site ever moved a
	buyer from a 3 USDC letter toward a 5,000 USDC engagement.
*/}
<section class="py-20 bg-slate-50 border-y border-slate-200">
	<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="rounded-2xl bg-white border border-slate-200 shadow-sm p-8 md:p-12">
			<div class="flex flex-wrap items-center gap-3">
				<span class="text-xs font-bold uppercase tracking-wider text-indigo-600">
					{t('home.bundle.eyebrow')}
				</span>
				<span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-indigo-50 text-indigo-700">
					{t('home.bundle.badge')}
				</span>
			</div>
			<h2 class="mt-4 text-3xl font-extrabold text-slate-900">{t('home.bundle.title')}</h2>
			<p class="mt-4 text-lg text-slate-600 max-w-3xl">{t('home.bundle.subtitle')}</p>

			<ul class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-3">
				{[
					t('home.bundle.item1'),
					t('home.bundle.item2'),
					t('home.bundle.item3'),
					t('home.bundle.item4'),
				].map((item) => (
					<li class="flex items-start gap-3 text-slate-700">
						<svg class="h-5 w-5 text-indigo-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
						</svg>
						<span>{item}</span>
					</li>
				))}
			</ul>

			<div class="mt-10 flex flex-col sm:flex-row sm:items-center gap-6">
				<div>
					<div class="text-3xl font-extrabold text-slate-900">{priceLabelFor('eu_presence')}</div>
					<div class="text-sm text-slate-500">{t('home.bundle.priceNote')}</div>
				</div>
				<a
					href={l('/eu-presence')}
					data-track="bundle_eu_presence"
					class="inline-flex items-center justify-center px-8 py-3 rounded-md bg-indigo-600 text-white font-semibold hover:bg-indigo-500"
				>
					{t('home.bundle.cta')}
				</a>
			</div>
		</div>
	</div>
</section>

<section class="py-20 bg-slate-900 text-white">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="text-center">
			<h2 class="text-3xl font-bold mb-8">{t('home.cta.title')}</h2>
			<div class="flex flex-col sm:flex-row justify-center gap-4">
				<a href={l('/pricing')} data-track="footer_pricing" class="px-8 py-3 bg-white text-slate-900 font-semibold rounded-lg hover:bg-slate-100 transition-colors">
					{t('home.cta.pricing')}
				</a>
				<a href={l('/playground')} data-track="footer_playground" class="px-8 py-3 bg-slate-800 text-white font-semibold rounded-lg hover:bg-slate-700 transition-colors border border-slate-700">
					{t('home.cta.playground')}
				</a>
				<a href="/docs/quickstart" class="px-8 py-3 bg-slate-800 text-white font-semibold rounded-lg hover:bg-slate-700 transition-colors border border-slate-700">
					{t('home.cta.docs')}
				</a>
			</div>
		</div>

		<div class="mt-16">
			<LeadCapture source="home" variant="dark" />
		</div>
	</div>
</section>
