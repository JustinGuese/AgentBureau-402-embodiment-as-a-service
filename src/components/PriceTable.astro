---
import { getLocaleFromUrl, useTranslations } from '../i18n/t';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const row = (id: string, price: string) => ({
	service: t(`pricing.table.services.${id}`),
	price,
	note: t(`pricing.table.notes.${id}`),
});

// Tiered so a 1 USDC fax and a 15,500 USDC GmbH are not read as one flat list:
// the buyer panel's acceptable range was $0.56-$10.04, which only the first tier sits in.
const tiers = [
	{
		title: t('pricing.tiers.perCall'),
		rows: [row('fax', '1.00 USDC'), row('letter', '3.00 USDC'), row('invoice', '5.00 USDC')],
	},
	{
		title: t('pricing.tiers.filings'),
		rows: [
			row('inkasso', '50.00 USDC'),
			row('vatReturn', '100.00 USDC'),
			row('annualFiling', '200.00 USDC'),
			row('vollmacht', '200.00 USDC'),
			row('bankAccount', '500.00 USDC'),
			row('vatRegister', '500.00 USDC'),
		],
	},
	{
		title: t('pricing.tiers.company'),
		footnote: t('pricing.tiers.companyNote'),
		rows: [
			row('ug', '1,500+ USDC'),
			row('vollmachtNotarized', '1,500.00 USDC'),
			row('gmbh', '15,500 USDC'),
			row('euPresence', '5,000.00 USDC'),
		],
	},
];
---

<div class="mt-12 rounded-xl border border-emerald-200 bg-emerald-50 p-6">
	<h3 class="text-lg font-bold text-slate-900">{t('pricing.tiers.free')}</h3>
	<p class="mt-1 text-sm text-slate-600">{t('pricing.tiers.freeDesc')}</p>
	<a href="/playground" data-track="pricing_free" class="mt-3 inline-flex text-sm font-bold text-emerald-800 hover:text-emerald-700">
		{t('hero.ctaPlayground')} &rarr;
	</a>
</div>

<div class="mt-8 overflow-hidden border border-slate-200 rounded-lg">
	<table class="min-w-full divide-y divide-slate-200">
		<thead class="bg-slate-50">
			<tr>
				<th scope="col" class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">{t('pricing.table.service')}</th>
				<th scope="col" class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">{t('pricing.table.price')}</th>
				<th scope="col" class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">{t('pricing.table.details')}</th>
			</tr>
		</thead>
		{tiers.map((tier) => (
			<tbody class="bg-white divide-y divide-slate-200 border-t border-slate-200">
				<tr class="bg-slate-50">
					<th scope="rowgroup" colspan="3" class="px-6 py-2 text-left text-xs font-semibold text-slate-700 uppercase tracking-wider">
						{tier.title}
						{tier.footnote && <span class="ml-2 font-normal normal-case text-slate-500">{tier.footnote}</span>}
					</th>
				</tr>
				{tier.rows.map((item) => (
					<tr>
						<td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-slate-900">{item.service}</td>
						<td class="px-6 py-4 whitespace-nowrap text-sm text-slate-600">{item.price}</td>
						<td class="px-6 py-4 whitespace-nowrap text-sm text-slate-500">{item.note}</td>
					</tr>
				))}
			</tbody>
		))}
	</table>
	<div class="bg-blue-50 px-6 py-4 border-t border-slate-200">
		<p class="text-xs text-blue-800">
			<strong>{t('pricing.table.note')}:</strong> {t('pricing.table.sync')}
		</p>
	</div>
</div>

<!--
	Metered inference does not fit the table above: that column is a flat price
	per act, and token pricing is per-million and per-model. Two indicative tiers
	only — a full model matrix goes stale within a quarter and reads as
	"we sell tokens", which this is not.
-->
<div class="mt-8 rounded-xl border border-slate-200 p-6 bg-white">
	<div class="flex items-baseline justify-between flex-wrap gap-2">
		<h3 class="text-lg font-bold text-slate-900">{t('pricing.credits.title')}</h3>
		<span class="text-xs font-semibold uppercase tracking-wider text-indigo-600">{t('pricing.credits.badge')}</span>
	</div>
	<p class="mt-2 text-sm text-slate-600">{t('pricing.credits.subtitle')}</p>

	<dl class="mt-6 grid grid-cols-1 sm:grid-cols-3 gap-4 text-sm">
		<div>
			<dt class="text-slate-500">{t('pricing.credits.topup')}</dt>
			<dd class="font-semibold text-slate-900">1.00 USDC</dd>
		</div>
		<div>
			<dt class="text-slate-500">{t('pricing.credits.tierSmall')}</dt>
			<dd class="font-semibold text-slate-900">from 0.15 USDC / 1M tok</dd>
		</div>
		<div>
			<dt class="text-slate-500">{t('pricing.credits.tierLarge')}</dt>
			<dd class="font-semibold text-slate-900">from 0.50 USDC / 1M tok</dd>
		</div>
	</dl>

	<p class="mt-4 text-xs text-slate-500">{t('pricing.credits.live')}</p>
	<a
		href="/docs/services/eu-inference"
		data-track="cta"
		class="mt-4 inline-flex items-center text-sm font-bold text-indigo-600 hover:text-indigo-500"
	>
		{t('pricing.credits.cta')} &rarr;
	</a>
</div>
