---
// Shared body for /pricing and /[lang]/pricing. These were hand-duplicated and had
// drifted: the localized copy still rendered an older four-card layout, two of whose
// cards referenced pricing.whyBase.instant.* / .zero.* — keys that exist in no locale
// file, so every non-English pricing page printed the literal key names on screen.
import PriceTable from './PriceTable.astro';
import { useTranslations, type Locale } from '../i18n/t';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const reasons = ['cheap', 'fast', 'native', 'wallets', 'backstop'] as const;

// The ZAG paragraph carries an inline link to the legal explainer, so it cannot be
// rendered by the same loop as the others.
const legalDesc = t('pricing.whyBase.legal.desc');
const ZAG = 'ZAG-Handelsvertreterausnahme';
const [legalBefore, legalAfter] = legalDesc.includes(ZAG)
  ? [legalDesc.split(ZAG)[0], legalDesc.split(ZAG)[1]]
  : [legalDesc, ''];
---

<div class="py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h1 class="text-4xl font-extrabold text-slate-900 sm:text-5xl">
        {t('pricing.title')}
      </h1>
      <p class="mt-4 text-xl text-slate-600 max-w-2xl mx-auto">
        {t('pricing.subtitle')}
      </p>
    </div>

    <div class="max-w-3xl mx-auto">
      <PriceTable />
    </div>

    <div class="mt-16 bg-slate-50 rounded-2xl p-8 md:p-12 border border-slate-100">
      <h2 class="text-2xl font-bold text-slate-900 mb-6">{t('pricing.whyBase.title')}</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 text-slate-600">
        {reasons.map((key) => (
          <div>
            <h3 class="font-bold text-slate-900 mb-2">{t(`pricing.whyBase.${key}.title`)}</h3>
            <p>{t(`pricing.whyBase.${key}.desc`)}</p>
          </div>
        ))}
        <div>
          <h3 class="font-bold text-slate-900 mb-2">{t('pricing.whyBase.legal.title')}</h3>
          <p>
            {legalBefore}
            {legalAfter !== '' && (
              <a href="/docs/legal/zag-exemption" class="text-blue-600 hover:underline">{ZAG}</a>
            )}
            {legalAfter}
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
