---
import Landing from '../../layouts/Landing.astro';
import PricingContent from '../../components/PricingContent.astro';
import { locales, useTranslations, type Locale } from '../../i18n/t';

export function getStaticPaths() {
  return locales.filter((l) => l !== 'en').map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const locale = lang as Locale;
const t = useTranslations(locale);
---

<Landing title={`${t('pricing.metaTitle')} - ${t('site.title')}`}>
  <PricingContent locale={locale} />
</Landing>
